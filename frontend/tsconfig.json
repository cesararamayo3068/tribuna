{
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true }
}
